[Unit]
Description=Ampache Music Server Container
Documentation=https://ampache.org/docker/
After=network-online.target docker.service shorewall.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ampache
ExecStart=/usr/bin/docker compose up --remove-orphans
ExecStop=/usr/bin/docker compose down
# Allow time for image pull on first start and MariaDB startup
TimeoutStartSec=600
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
