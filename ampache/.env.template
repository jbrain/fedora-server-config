# Copy this to /opt/ampache/.env and fill in secure values before first run.
# Never commit the real .env to source control.
# Generate strong passwords: openssl rand -base64 24

# MariaDB root/admin password (used only by the MariaDB container itself)
MYSQL_ROOT_PASS=changeme-root

# MariaDB ampache user password (used by the ampache container to connect)
MYSQL_PASS=changeme

# Ampache web UI admin password
AMPACHE_ADMIN_PASSWORD=changeme
