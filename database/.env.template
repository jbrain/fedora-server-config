# Copy to .env and fill in with strong values (e.g. `openssl rand -base64 24`),
# then `chmod 600 .env`. Never commit the real .env.

# MariaDB server root password (used only for admin/maintenance via `podman exec`).
MARIADB_ROOT_PASSWORD=

# Per-app least-privilege DB passwords — must match the values substituted into
# initdb.d/01-databases.sql by setup.sh, and the values each app's own config
# (wp-config.php, airsonic.properties, ampache .env) is updated to use.
WORDPRESS_DB_PASSWORD=
AIRSONIC_DB_PASSWORD=
AMPACHE_DB_PASSWORD=
