[Unit]
Description=Shared MariaDB Container (wordpress, airsonic, ampache)
Documentation=https://mariadb.com/kb/en/mariadb-server-docker-official-image/
After=network-online.target podman.socket
Requires=podman.socket
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/shared-mariadb
ExecStart=/usr/bin/podman compose up --remove-orphans
ExecStop=/usr/bin/podman compose down
# Allow time for image pull on first start and MariaDB initialization/upgrade
TimeoutStartSec=600
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
