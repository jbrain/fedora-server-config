{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jackson-brain/ampache-recently-played",
	"title": "Ampache Recently Played",
	"category": "widgets",
	"icon": "clock",
	"description": "A short list of recently played tracks from the local Ampache library.",
	"textdomain": "jackson-brain-ampache",
	"attributes": {
		"headingLevel": {
			"type": "number",
			"default": 2
		},
		"showArt": {
			"type": "boolean",
			"default": true
		},
		"limit": {
			"type": "number",
			"default": 5
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "jba-blocks-editor",
	"style": "jba-blocks",
	"render": "file:./render.php"
}
