{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jackson-brain/ampache-library-stats",
	"title": "Ampache Library Statistics",
	"category": "widgets",
	"icon": "chart-bar",
	"description": "Song, album, artist, genre, and playlist totals from the local Ampache library.",
	"textdomain": "jackson-brain-ampache",
	"attributes": {
		"headingLevel": {
			"type": "number",
			"default": 2
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "jba-blocks-editor",
	"style": "jba-blocks",
	"render": "file:./render.php"
}
